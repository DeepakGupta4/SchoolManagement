# Copy to `.env` and fill in. `.env` is git-ignored.

NODE_ENV=development
PORT=4000

# MongoDB connection string.
# Leave BLANK in development to run on a throwaway in-memory database
# (no install needed, but every restart wipes it).
# REQUIRED in production — get a free cluster at https://mongodb.com/atlas
# Example: mongodb+srv://user:pass@cluster.mongodb.net/schoolos
MONGODB_URI=

# Signs auth tokens. Use a long random string; changing it logs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- SaaS onboarding ----

# Product name used in emails/templates.
SOFTWARE_NAME=SchoolDeck

# Where the approval email tells schools to sign in.
APP_LOGIN_URL=http://localhost:3000/login

# Free trial length in days. The backend is the sole authority on expiry.
TRIAL_DAYS=7

# Gmail SMTP for approval/trial emails. Create an App Password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
# Leave BLANK to log emails to the console instead of sending them.
SMTP_USER=schooldeck.in@gmail.com
SMTP_PASS=

# A Super Admin (platform owner) is created at boot from these, so a fresh
# deployment always has someone who can approve schools. Leave blank to skip.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Owner

# ---- Payments (Razorpay) ----
# From the Razorpay dashboard → Settings → API Keys. Leave blank to disable
# online payment (schools then activate via the Super Admin instead).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Plan prices in paise (₹1 = 100 paise). Defaults: ₹1,999 / month, ₹19,999 / year.
PLAN_MONTHLY_PRICE=199900
PLAN_YEARLY_PRICE=1999900
